# À copier vers .env SUR LE SERVEUR (jamais dans le dépôt ni dans un zip). Adapter les valeurs.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://VOTRE-DOMAINE
# Générer avec : php artisan key:generate   (nouvelle clé pour la production)
APP_KEY=

LOG_CHANNEL=stack
LOG_STACK=secure
LOG_LEVEL=error

# Base de données : utilisateur DÉDIÉ avec mot de passe fort (jamais root)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=providence
DB_USERNAME=providence_app
DB_PASSWORD=

# Sessions et cookies (HTTPS obligatoire)
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_COOKIE=__Host-providence_session
SESSION_DOMAIN=null

# CSP : mettre true quelques jours pour tester sans bloquer, puis false
CSP_REPORT_ONLY=true

# Hachage (optionnel, voir SECURITY-CHANGES.md pour la migration vers Argon2id)
BCRYPT_ROUNDS=12
